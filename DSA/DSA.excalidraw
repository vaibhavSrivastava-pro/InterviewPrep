    {
      "id": "WQzGUjeEsiOR2cM0o6nkY",
      "type": "text",
      "x": 10602.697289914504,
      "y": -484.6714546721872,
      "width": 778.575439453125,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dotted",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bcj",
      "roundness": null,
      "seed": 37468091,
      "version": 138,
      "versionNonce": 1059306018,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793272864614,
      "created": 1793272586142,
      "link": null,
      "locked": false,
      "text": "Core idea: Track a range of possible unmatched opening brackets `(` instead of deciding what each\n`*` represents.",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Core idea: Track a range of possible unmatched opening brackets `(` instead of deciding what each `*` represents.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "G6JBZxzvT9PpxXBjDjR7p",
      "type": "text",
      "x": 10819.569177121535,
      "y": -394.6714546721872,
      "width": 344.8316650390625,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dotted",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bck",
      "roundness": null,
      "seed": 440989045,
      "version": 138,
      "versionNonce": 27652350,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793272864614,
      "created": 1793272586142,
      "link": null,
      "locked": false,
      "text": "- `leftMin`: minimum possible unmatched `(`.",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- `leftMin`: minimum possible unmatched `(`.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "nxkYTseO8J15ou6AQT9iW",
      "type": "text",
      "x": 10813.217187375441,
      "y": -364.6714546721872,
      "width": 357.53564453125,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dotted",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bcl",
      "roundness": null,
      "seed": 1124272219,
      "version": 138,
      "versionNonce": 1219241442,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793272864614,
      "created": 1793272586142,
      "link": null,
      "locked": false,
      "text": "- `leftMax`: maximum possible unmatched `(`.",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- `leftMax`: maximum possible unmatched `(`.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "bdJmrilX6cV4lRGyYCz4O",
      "type": "text",
      "x": 10916.049073666945,
      "y": -304.6714546721872,
      "width": 151.8718719482422,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dotted",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bcm",
      "roundness": null,
      "seed": 685014741,
      "version": 138,
      "versionNonce": 66789694,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793272864614,
      "created": 1793272586142,
      "link": null,
      "locked": false,
      "text": "For each character:",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "For each character:",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "pCFa2xpbdM-mnIjlgZ_r6",
      "type": "text",
      "x": 10799.321160764113,
      "y": -244.67145467218722,
      "width": 385.32769775390625,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dotted",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bcn",
      "roundness": null,
      "seed": 1540834555,
      "version": 138,
      "versionNonce": 632363426,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793272864614,
      "created": 1793272586144,
      "link": null,
      "locked": false,
      "text": "- `(` → increment both `leftMin` and `leftMax`.",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- `(` → increment both `leftMin` and `leftMax`.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "LuDMNwd_QvAeDajSicW77",
      "type": "text",
      "x": 10895.857095212355,
      "y": -214.67145467218722,
      "width": 192.25582885742188,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dotted",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bco",
      "roundness": null,
      "seed": 1676139573,
      "version": 138,
      "versionNonce": 482363774,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793272864614,
      "created": 1793272586144,
      "link": null,
      "locked": false,
      "text": "- `)` → decrement both.",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- `)` → decrement both.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "gF9PbSoN3vSgSe_qt3tjO",
      "type": "text",
      "x": 10604.921411008254,
      "y": -194.67145467218722,
      "width": 774.127197265625,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dotted",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bcp",
      "roundness": null,
      "seed": 339406235,
      "version": 138,
      "versionNonce": 1164023138,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793272864614,
      "created": 1793272586145,
      "link": null,
      "locked": false,
      "text": "- → decrement `leftMin` (acts as `)`), increment `leftMax` (acts as `(`). It could also be empty,\nkeeping the count unchanged.",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- → decrement `leftMin` (acts as `)`), increment `leftMax` (acts as `(`). It could also be empty, keeping the count unchanged.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "Y77AtSh1_DEMdaPpZfMVW",
      "type": "text",
      "x": 10921.20906969966,
      "y": -104.67145467218722,
      "width": 141.5518798828125,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dotted",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bcq",
      "roundness": null,
      "seed": 325619093,
      "version": 138,
      "versionNonce": 1798728126,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793272864614,
      "created": 1793272586145,
      "link": null,
      "locked": false,
      "text": "Important checks:",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Important checks:",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "hNrRs4VA2AK06SGhRa2v6",
      "type": "text",
      "x": 10624.065331906691,
      "y": -54.671454672187224,
      "width": 735.83935546875,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dotted",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bcr",
      "roundness": null,
      "seed": 526418491,
      "version": 138,
      "versionNonce": 1493997858,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793272864614,
      "created": 1793272586145,
      "link": null,
      "locked": false,
      "text": "1. If `leftMax < 0`, return `False`: too many closing brackets, even under the most favorable\ninterpretation.",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. If `leftMax < 0`, return `False`: too many closing brackets, even under the most favorable interpretation.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "vm1jdhhKD70W759qkl2AS",
      "type": "text",
      "x": 10657.937280148879,
      "y": 5.328545327812776,
      "width": 668.095458984375,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dotted",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bcs",
      "roundness": null,
      "seed": 1720455925,
      "version": 138,
      "versionNonce": 2122220030,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793272864614,
      "created": 1793272586145,
      "link": null,
      "locked": false,
      "text": "2. If `leftMin < 0`, reset it to `0`: unmatched opening brackets cannot be negative.",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2. If `leftMin < 0`, reset it to `0`: unmatched opening brackets cannot be negative.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "-5jiT4-HZPrDox_V2UUOb",
      "type": "text",
      "x": 10672.553338498488,
      "y": 35.328545327812776,
      "width": 638.8633422851562,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dotted",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bct",
      "roundness": null,
      "seed": 640320219,
      "version": 138,
      "versionNonce": 270607586,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793272864614,
      "created": 1793272586146,
      "link": null,
      "locked": false,
      "text": "3. At the end, return `leftMin == 0`: at least one interpretation can be balanced.",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3. At the end, return `leftMin == 0`: at least one interpretation can be balanced.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "-xwmcnLSK24HIPhZyNOHT",
      "type": "text",
      "x": 10829.481149167434,
      "y": 95.32854532781278,
      "width": 325.0077209472656,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dotted",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bcu",
      "roundness": null,
      "seed": 165145685,
      "version": 138,
      "versionNonce": 1503236670,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793272864614,
      "created": 1793272586146,
      "link": null,
      "locked": false,
      "text": "Complexity: \\(O(n)\\) time, \\(O(1)\\) space.",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Complexity: \\(O(n)\\) time, \\(O(1)\\) space.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "GldUdYU1apSnDWfGqyUaY",
      "type": "text",
      "x": 10686.817223996535,
      "y": 155.32854532781278,
      "width": 610.3355712890625,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dotted",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bcv",
      "roundness": null,
      "seed": 288059259,
      "version": 138,
      "versionNonce": 1412315298,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793272864614,
      "created": 1793272586146,
      "link": null,
      "locked": false,
      "text": "> If too many “(” then `leftMin` > 0 and if too many “)” then `leftMax`  < 0",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "> If too many “(” then `leftMin` > 0 and if too many “)” then `leftMax`  < 0",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
