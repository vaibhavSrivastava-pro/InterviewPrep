    {
      "id": "PQPsAnQTN1Fhj5X-DCJxK",
      "type": "text",
      "x": 9935.38668761657,
      "y": -2061.954159064929,
      "width": 789.6791381835938,
      "height": 140,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dotted",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bc5",
      "roundness": null,
      "seed": 289517045,
      "version": 5,
      "versionNonce": 113696546,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1793272864614,
      "created": 1793271501474,
      "link": null,
      "locked": false,
      "text": "**We can use the Depth First Search (DFS) algorithm starting from the border cells of the grid.\nHowever, we reverse the condition such that the next visiting cell should have a height greater than\nor equal to the current cell. For the top and left borders connected to the Pacific Ocean, we use a\nhash set called** `pacific` **and run a DFS from each of these cells, visiting nodes recursively.\nSimilarly, for the bottom and right borders connected to the Atlantic Ocean, we use a hash set\ncalled** `atlantic` **and run a DFS. The required coordinates are the cells that exist in both the**\n`pacific` **and** `atlantic` **sets.**",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "**We can use the Depth First Search (DFS) algorithm starting from the border cells of the grid. However, we reverse the condition such that the next visiting cell should have a height greater than or equal to the current cell. For the top and left borders connected to the Pacific Ocean, we use a hash set called** `pacific` **and run a DFS from each of these cells, visiting nodes recursively. Similarly, for the bottom and right borders connected to the Atlantic Ocean, we use a hash set called** `atlantic` **and run a DFS. The required coordinates are the cells that exist in both the** `pacific` **and** `atlantic` **sets.**",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "u1hkV2ntwRvzQwfOGJ8Pk",
      "type": "text",
      "x": 9900.93834151029,
      "y": -2077.586189551258,
      "width": 561.4878719162516,
      "height": 180,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dotted",
      "roughness": 0,
