      "type": "text",
      "x": -1957.3124379750266,
      "y": 1884.1270492775593,
      "width": 229.77648971403977,
      "height": 157.49492642803185,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
