      "index": "bdw",
      "roundness": null,
      "seed": 881125272,
      "version": 291,
      "versionNonce": 422204640,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793272909494,
      "link": null,
      "locked": false,
      "text": "The Builder Design Pattern is a creational design pattern that helps in constructing complex objects step-by-step. \nThis pattern is especially useful when an object has many attributes or optional fields, allowing you to create\ndifferent configurations of the object easily and clearly.",
      "fontSize": 7.685702313322021,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The Builder Design Pattern is a creational design pattern that helps in constructing complex objects step-by-step. \nThis pattern is especially useful when an object has many attributes or optional fields, allowing you to create different configurations of the object easily and clearly.",
      "autoResize": false,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
