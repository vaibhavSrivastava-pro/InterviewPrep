    {
      "id": "hf4ux3p8xLrsJcrYdTuf7",
      "type": "text",
      "x": 5087.130502284602,
      "y": 162.49131814413414,
      "width": 472.1946928463731,
      "height": 209.05933346729017,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bkA",
      "roundness": null,
      "seed": 443603321,
      "version": 183,
      "versionNonce": 1508358368,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "WPEVic_6VYuj4gh4ZZsE2",
          "type": "arrow"
        }
      ],
      "updated": 1793272909494,
      "link": null,
      "locked": false,
      "text": "public class LeaveRequestChainDemo {\n  public static void main(String[] args) {\n    // Create handler instances\n    Approver supervisor = new Supervisor();\n    Approver manager = new Manager();\n    Approver director = new Director();\n    // Set up the chain: Supervisor -> Manager -> Director\n    supervisor.setNextApprover(manager);\n    manager.setNextApprover(director);\n    // Process a leave request\n    int leaveDays = 10;\n    System.out.println(\"Employee requests \" + leaveDays + \" days of leave.\");\n    supervisor.processLeaveRequest(leaveDays);\n  }\n}",
      "fontSize": 11.149831118255475,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "public class LeaveRequestChainDemo {\n  public static void main(String[] args) {\n    // Create handler instances\n    Approver supervisor = new Supervisor();\n    Approver manager = new Manager();\n    Approver director = new Director();\n    // Set up the chain: Supervisor -> Manager -> Director\n    supervisor.setNextApprover(manager);\n    manager.setNextApprover(director);\n    // Process a leave request\n    int leaveDays = 10;\n    System.out.println(\"Employee requests \" + leaveDays + \" days of leave.\");\n    supervisor.processLeaveRequest(leaveDays);\n  }\n}",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
