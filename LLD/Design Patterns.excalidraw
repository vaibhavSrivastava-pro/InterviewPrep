      "updated": 1793272909494,
      "link": null,
      "locked": false,
      "text": "public class Car {\n  private String engine;\n  private int wheels;\n  private int seats;\n\n\n  // builder\n  private Car(CarBuilder builder) {\n    this.engine = builder.engine;\n    this.wheels = builder.wheels;\n    this.seats = builder.seats;\n  }\n\n  // Getter methods for the fields\n  public String getEngine() {\n    return engine;\n  }\n  public int getWheels() {\n    return wheels;\n  }\n  public int getSeats() {\n    return seats;\n  }\n}",
      "fontSize": 7.685702313322019,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "public class Car {\n  private String engine;\n  private int wheels;\n  private int seats;\n\n\n  // builder\n  private Car(CarBuilder builder) {\n    this.engine = builder.engine;\n    this.wheels = builder.wheels;\n    this.seats = builder.seats;\n  }\n\n  // Getter methods for the fields\n  public String getEngine() {\n    return engine;\n  }\n  public int getWheels() {\n    return wheels;\n  }\n  public int getSeats() {\n    return seats;\n  }\n}",
      "autoResize": false,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
