    {
      "id": "dS58_LISAjCWoz1MKa962",
      "type": "text",
      "x": 786.2246916317324,
      "y": 1630.3783280132252,
      "width": 320.5961222855664,
      "height": 145.72571227506705,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dashed",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
