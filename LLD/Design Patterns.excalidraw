      "isDeleted": false,
      "boundElements": [],
      "updated": 1793272909494,
      "link": null,
      "locked": false,
      "text": "Strategy",
      "fontSize": 13.449979048313534,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
