      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bh3",
      "roundness": null,
      "seed": 1048497896,
      "version": 574,
      "versionNonce": 2002020640,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793272909494,
      "link": null,
      "locked": false,
      "text": "class TrafficLightContext {\n  private TrafficLightState currentState;\n  public TrafficLightContext() {\n    currentState = new RedState(); // Start with RED\n  }\n  public void setState(TrafficLightState state) {\n    this.currentState = state;\n  }\n  public void next() {\n    currentState.next(this);\n  }\n  public String getColor() {\n    return currentState.getColor();\n  }\n}",
      "fontSize": 7.685702313322019,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class TrafficLightContext {\n  private TrafficLightState currentState;\n  public TrafficLightContext() {\n    currentState = new RedState(); // Start with RED\n  }\n  public void setState(TrafficLightState state) {\n    this.currentState = state;\n  }\n  public void next() {\n    currentState.next(this);\n  }\n  public String getColor() {\n    return currentState.getColor();\n  }\n}",
      "autoResize": true,
