    {
      "id": "kNGqpxFGaeNawvJSUXF9i",
      "type": "text",
      "x": 923.148773747524,
      "y": -790.6601158794401,
      "width": 186.07401994307116,
      "height": 220.9639415080081,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "beB",
      "roundness": null,
      "seed": 861760744,
      "version": 1360,
      "versionNonce": 1511091488,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793272909494,
      "link": null,
      "locked": false,
      "text": "public class Logger {\n  private static volatile Logger\n      instance; // volatile keyword ensures\nvisibility across threads\n  private Logger() {} // Private constructor\nto prevent instantiation\n\n  public static Logger getInstance() {\n    if (instance == null) { \n      synchronized (\n          Logger.class) { \n        if (instance == null) { \n          instance = new Logger(); \n        }\n      }\n    }\n    return instance;\n  }\n\n  public void log(String message) {\n    System.out.println(\"Log: \" + message);\n  }\n}",
      "fontSize": 7.685702313322019,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "public class Logger {\n  private static volatile Logger\n      instance; // volatile keyword ensures visibility across threads\n  private Logger() {} // Private constructor to prevent instantiation\n\n  public static Logger getInstance() {\n    if (instance == null) { \n      synchronized (\n          Logger.class) { \n        if (instance == null) { \n          instance = new Logger(); \n        }\n      }\n    }\n    return instance;\n  }\n\n  public void log(String message) {\n    System.out.println(\"Log: \" + message);\n  }\n}",
      "autoResize": false,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
