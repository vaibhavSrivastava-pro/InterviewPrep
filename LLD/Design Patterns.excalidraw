      "isDeleted": false,
      "boundElements": [],
      "updated": 1793272909494,
      "link": null,
      "locked": false,
      "text": "public class Logger {\n  private static Logger instance;\n\n  private Logger() {}\n\n  public static Logger getInstance() {\n    if (instance == null) {\n      instance = new Logger(); \n    }\n    return instance; \n  }\n  public void log(String message) {\n    System.out.println(\"Log: \" + message);\n  }\n}",
      "fontSize": 7.685702313322019,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "public class Logger {\n  private static Logger instance;\n\n  private Logger() {}\n\n  public static Logger getInstance() {\n    if (instance == null) {\n      instance = new Logger(); \n    }\n    return instance; \n  }\n  public void log(String message) {\n    System.out.println(\"Log: \" + message);\n  }\n}",
      "autoResize": false,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
