    {
      "id": "1dIAXTmaSWLXKYXsFpA4F",
      "type": "text",
      "x": 5479.992151079875,
      "y": 678.8295440471261,
      "width": 304.4959701872895,
      "height": 107.38509142475664,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bjv",
      "roundness": null,
      "seed": 180454327,
      "version": 206,
      "versionNonce": 71558432,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793272909494,
      "link": null,
      "locked": false,
      "text": "abstract class Approver {\n  protected Approver nextApprover;\n  // Set the next handler in the chain\n  public void setNextApprover(Approver nextApprover) {\n    this.nextApprover = nextApprover;\n  }\n  // Abstract method to process the leave request\n  public abstract void processLeaveRequest(int leaveDays);\n}",
      "fontSize": 9.545341459978362,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "abstract class Approver {\n  protected Approver nextApprover;\n  // Set the next handler in the chain\n  public void setNextApprover(Approver nextApprover) {\n    this.nextApprover = nextApprover;\n  }\n  // Abstract method to process the leave request\n  public abstract void processLeaveRequest(int leaveDays);\n}",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
