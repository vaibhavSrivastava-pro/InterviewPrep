    {
      "id": "v8ZgwEjxWxsR6S7tm_JLL",
      "type": "text",
      "x": -678.0224271595264,
      "y": 1548.8176659580881,
      "width": 250.64622586851877,
      "height": 134.49979048313534,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bi1",
      "roundness": null,
      "seed": 1068022105,
      "version": 431,
      "versionNonce": 619295008,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793272909494,
      "link": null,
      "locked": false,
      "text": "    AirConditioner airConditioner = new AirConditioner();\n    SmartLight smartLight = new SmartLight();\n    System.out.println(\"Turning ON devices in Room 1...\");\n    airConditioner.turnOn();\n    smartLight.turnOn();\n    System.out.println(\"Turning OFF devices in Room 1...\");\n    airConditioner.turnOff();\n    smartLight.turnOff();\n    // Manually managing multiple rooms\n    System.out.println(\"Turning ON devices in Floor 1...\");\n    airConditioner.turnOn();\n    smartLight.turnOn();\n    airConditioner.turnOn(); // Room 2\n    smartLight.turnOn(); // Room 2",
      "fontSize": 7.685702313322021,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "    AirConditioner airConditioner = new AirConditioner();\n    SmartLight smartLight = new SmartLight();\n    System.out.println(\"Turning ON devices in Room 1...\");\n    airConditioner.turnOn();\n    smartLight.turnOn();\n    System.out.println(\"Turning OFF devices in Room 1...\");\n    airConditioner.turnOff();\n    smartLight.turnOff();\n    // Manually managing multiple rooms\n    System.out.println(\"Turning ON devices in Floor 1...\");\n    airConditioner.turnOn();\n    smartLight.turnOn();\n    airConditioner.turnOn(); // Room 2\n    smartLight.turnOn(); // Room 2",
      "autoResize": false,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "Med1dALXaOkMy_nhIHnN8",
      "type": "rectangle",
      "x": -671.8053854691841,
      "y": 1523.3884987350239,
      "width": 257.3669479074197,
      "height": 168.75380551615504,
