      "isDeleted": false,
      "boundElements": [],
      "updated": 1793272909494,
      "link": null,
      "locked": false,
      "text": "public void pressVolumeButton(int volume) {\n    tv.adjustVolume(volume);\n  }\n  // New methods are added each time we need more actions\n  public void pressOnChangeVolumeAndChannelButton(int volume, int\nchannel) {\n    tv.turnOn();\n    tv.changeChannel(channel);\n    tv.adjustVolume(volume);\n  }",
      "fontSize": 7.685702313322018,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "public void pressVolumeButton(int volume) {\n    tv.adjustVolume(volume);\n  }\n  // New methods are added each time we need more actions\n  public void pressOnChangeVolumeAndChannelButton(int volume, int channel) {\n    tv.turnOn();\n    tv.changeChannel(channel);\n    tv.adjustVolume(volume);\n  }",
      "autoResize": false,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "SkyWgezqj_vzQUx-B-Pru",
      "type": "text",
      "x": 2536.632613627339,
      "y": 18.768602363671107,
      "width": 205.04954517652897,
