    },
    {
      "id": "Gu6SmGQO0ZpmxPfXujRDP",
      "type": "text",
      "x": -222.08484071908197,
      "y": 166.57968229217477,
      "width": 278.990606967705,
      "height": 76.8570231332202,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ben",
      "roundness": null,
      "seed": 1807908584,
      "version": 540,
      "versionNonce": 1147715872,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793272909494,
      "link": null,
      "locked": false,
      "text": "public void notifySubscribers() {\n  for (String subscriber : subscribers) {\n    System.out.println(\n        \"Notifying \" + subscriber + \" about new video: \" + video);\n    // Add new feature: send an email notification\n    sendEmail(subscriber);\n  }\n}",
      "fontSize": 7.685702313322018,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "public void notifySubscribers() {\n  for (String subscriber : subscribers) {\n    System.out.println(\n        \"Notifying \" + subscriber + \" about new video: \" + video);\n    // Add new feature: send an email notification\n    sendEmail(subscriber);\n  }\n}",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "T_emhRDLdh31nodkHbr9n",
      "type": "text",
