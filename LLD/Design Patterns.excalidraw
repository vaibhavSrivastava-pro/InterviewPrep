      "isDeleted": false,
      "boundElements": [
        {
          "id": "bwksQOIy9AfZziXgwpHac",
          "type": "arrow"
        }
      ],
      "updated": 1793272909494,
      "link": null,
      "locked": false,
      "text": "public class CoffeeShop {\n    public static void main(String[] args) {\n        Coffee coffee = new Espresso();\n        coffee = new MilkDecorator(coffee);\n        coffee = new SugarDecorator(coffee);\n        System.out.println(\"Order: \" + coffee.getDescription());\n        System.out.println(\"Total Cost: $\" + coffee.getCost());\n        Coffee anotherCoffee = new Cappuccino();\n        anotherCoffee = new VanillaDecorator(anotherCoffee);\n        System.out.println(\"\nOrder: \" + anotherCoffee.getDescription());\n        System.out.println(\"Total Cost: $\" + anotherCoffee.getCost());\n    }\n}",
      "fontSize": 8.327183558575255,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "public class CoffeeShop {\n    public static void main(String[] args) {\n        Coffee coffee = new Espresso();\n        coffee = new MilkDecorator(coffee);\n        coffee = new SugarDecorator(coffee);\n        System.out.println(\"Order: \" + coffee.getDescription());\n        System.out.println(\"Total Cost: $\" + coffee.getCost());\n        Coffee anotherCoffee = new Cappuccino();\n        anotherCoffee = new VanillaDecorator(anotherCoffee);\n        System.out.println(\"\nOrder: \" + anotherCoffee.getDescription());\n        System.out.println(\"Total Cost: $\" + anotherCoffee.getCost());\n    }\n}",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
