    {
      "id": "NXHbVuipzHEb7EGxhBgLu",
      "type": "text",
      "x": 1816.19241921524,
      "y": 1772.4323678124888,
      "width": 239.09071463913386,
      "height": 135.847185396194,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dashed",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bjf",
      "roundness": null,
      "seed": 1728688569,
      "version": 634,
      "versionNonce": 494077216,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793272909494,
      "link": null,
      "locked": false,
      "text": "public class MilkDecorator extends CoffeeDecorator {\n    public MilkDecorator(Coffee coffee) {\n        super(coffee);\n    }\n    @Override\n    public String getDescription() {\n        return coffee.getDescription() + \", Milk\";\n    }\n    @Override\n    public double getCost() {\n        return coffee.getCost() + 0.50;\n    }\n}",
      "fontSize": 8.359826793611939,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "public class MilkDecorator extends CoffeeDecorator {\n    public MilkDecorator(Coffee coffee) {\n        super(coffee);\n    }\n    @Override\n    public String getDescription() {\n        return coffee.getDescription() + \", Milk\";\n    }\n    @Override\n    public double getCost() {\n        return coffee.getCost() + 0.50;\n    }\n}",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
