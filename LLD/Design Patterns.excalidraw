    {
      "id": "mCZbc36520EJk_5sOp1sP",
      "type": "text",
      "x": 5673.281324133483,
      "y": 511.4233566541833,
      "width": 355.67757323590706,
      "height": 137.0100410705831,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
