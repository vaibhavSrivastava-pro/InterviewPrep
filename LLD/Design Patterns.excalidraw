      "type": "text",
      "x": 229.42855878877708,
      "y": -794.8396919258473,
      "width": 192.16682085755792,
      "height": 227.47051068248416,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
