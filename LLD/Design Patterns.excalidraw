      "seed": 75855895,
      "version": 414,
      "versionNonce": 1353554144,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793272909494,
      "link": null,
      "locked": false,
      "text": "// Create adapters for each device\n    SmartDevice airConditioner =\n        new AirConditionerAdapter(new AirConditioner());\n    SmartDevice smartLight = new SmartLightAdapter(new SmartLight());\n    SmartDevice coffeeMachine = new CoffeeMachineAdapter(new CoffeeMachine());\n    // Control devices through the unified interface\n    airConditioner.turnOn();\n    smartLight.turnOn();\n    coffeeMachine.turnOn();\n    airConditioner.turnOff();\n    smartLight.turnOff();\n    coffeeMachine.turnOff();",
      "fontSize": 7.685702313322019,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "// Create adapters for each device\n    SmartDevice airConditioner =\n        new AirConditionerAdapter(new AirConditioner());\n    SmartDevice smartLight = new SmartLightAdapter(new SmartLight());\n    SmartDevice coffeeMachine = new CoffeeMachineAdapter(new CoffeeMachine());\n    // Control devices through the unified interface\n    airConditioner.turnOn();\n    smartLight.turnOn();\n    coffeeMachine.turnOn();\n    airConditioner.turnOff();\n    smartLight.turnOff();\n    coffeeMachine.turnOff();",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
