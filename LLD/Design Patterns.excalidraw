      "text": "class CoffeeBeverage extends Beverage {\n  @Override\n  void brew() {\n    System.out.println(\"Brewing coffee...\");\n  }\n  @Override\n  void addCondiments() {\n    System.out.println(\"Adding sugar and milk...\");\n  }\n}",
