      "boundElements": [],
      "updated": 1793272909494,
      "link": null,
      "locked": false,
      "text": "public class TV {\n  public void turnOn() {\n    System.out.println(\"TV is ON\");\n  }\n  public void turnOff() {\n    System.out.println(\"TV is OFF\");\n  }\n  public void changeChannel(int channel) {\n    System.out.println(\"Channel changed to \" + channel);\n  }\n  public void adjustVolume(int volume) {\n    System.out.println(\"Volume set to \" + volume);\n  }\n}",
      "fontSize": 7.685702313322021,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "public class TV {\n  public void turnOn() {\n    System.out.println(\"TV is ON\");\n  }\n  public void turnOff() {\n    System.out.println(\"TV is OFF\");\n  }\n  public void changeChannel(int channel) {\n    System.out.println(\"Channel changed to \" + channel);\n  }\n  public void adjustVolume(int volume) {\n    System.out.println(\"Volume set to \" + volume);\n  }\n}",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
