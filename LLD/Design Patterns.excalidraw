    {
      "id": "gkCCFGmv5P15VYFADxaEn",
      "type": "text",
      "x": -37.66937219371357,
      "y": -1044.4915909174047,
      "width": 446.0553969812866,
      "height": 28.82138367495758,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
