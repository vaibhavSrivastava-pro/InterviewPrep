    {
      "id": "HPz-3hB54tOoMVkjfbjr_",
      "type": "text",
      "x": 4226.61937359736,
      "y": 445.0730789675604,
      "width": 274.76347655910337,
      "height": 57.64276734991516,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bh8",
      "roundness": null,
      "seed": 201092760,
      "version": 508,
      "versionNonce": 1326022880,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793272909494,
      "link": null,
      "locked": false,
      "text": "    TrafficLightContext trafficLight = new TrafficLightContext();\n    trafficLight.next(); // RED -> GREEN\n    trafficLight.next(); // GREEN -> YELLOW\n    trafficLight.next(); // YELLOW -> RED\n    trafficLight.next(); // RED -> GREEN\n    // Adding new states like BLINKING or MAINTENANCE is easy now",
      "fontSize": 7.685702313322018,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "    TrafficLightContext trafficLight = new TrafficLightContext();\n    trafficLight.next(); // RED -> GREEN\n    trafficLight.next(); // GREEN -> YELLOW\n    trafficLight.next(); // YELLOW -> RED\n    trafficLight.next(); // RED -> GREEN\n    // Adding new states like BLINKING or MAINTENANCE is easy now",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
