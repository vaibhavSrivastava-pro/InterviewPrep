    {
      "id": "1AHonjUkLbTkhF3_8I8vv",
      "type": "text",
      "x": -673.6463366773837,
      "y": 1915.0149518532176,
      "width": 270.5363461505018,
      "height": 201.749685724703,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "biK",
      "roundness": null,
      "seed": 1639501817,
      "version": 517,
      "versionNonce": 1043428576,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793272909494,
      "link": null,
      "locked": false,
      "text": "public class CompositeSmartComponent implements SmartComponent {\n  private List<SmartComponent> components = new ArrayList<>();\npublic void addComponent(SmartComponent component) {\n    components.add(component);\n  }\n  public void removeComponent(SmartComponent component) {\n    components.remove(component);\n  }\n  @Override\n  public void turnOn() {\n    for (SmartComponent component : components) {\n      component.turnOn();\n    }\n  }\n  @Override\n  public void turnOff() {\n    for (SmartComponent component : components) {\n      component.turnOff();\n    }\n  }\n}",
      "fontSize": 7.685702313322018,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "public class CompositeSmartComponent implements SmartComponent {\n  private List<SmartComponent> components = new ArrayList<>();\npublic void addComponent(SmartComponent component) {\n    components.add(component);\n  }\n  public void removeComponent(SmartComponent component) {\n    components.remove(component);\n  }\n  @Override\n  public void turnOn() {\n    for (SmartComponent component : components) {\n      component.turnOn();\n    }\n  }\n  @Override\n  public void turnOff() {\n    for (SmartComponent component : components) {\n      component.turnOff();\n    }\n  }\n}",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
