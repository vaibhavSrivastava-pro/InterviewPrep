      "isDeleted": false,
      "boundElements": [],
      "updated": 1793272909494,
      "link": null,
      "locked": false,
      "text": "Making each state decoupled.  \n\nWe have a single Context Class that can manager\nthese various states",
      "fontSize": 7.685702313322019,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Making each state decoupled.  \n\nWe have a single Context Class that can manager these various states",
      "autoResize": false,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "BUdudFbgCBaOSUgF5dVqw",
      "type": "text",
      "x": 3544.2556386962897,
      "y": 153.29960481647277,
      "width": 236.6825799946293,
      "height": 230.57106939966064,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bgk",
      "roundness": null,
      "seed": 331452648,
      "version": 406,
      "versionNonce": 25153760,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793272909494,
      "link": null,
      "locked": false,
      "text": "public class TrafficLight {\n  private String color;\n  public TrafficLight() {\n    this.color = \"RED\"; // start with red\n  }\n  public void next() {\n    if (color.equals(\"RED\")) {\n      color = \"GREEN\";\n      System.out.println(\"Light changed from RED to\nGREEN. Cars go!\");\n    } else if (color.equals(\"GREEN\")) {\n      color = \"YELLOW\";\n      System.out.println(\"Light changed from GREEN to\nYELLOW. Slow down!\");\n    } else if (color.equals(\"YELLOW\")) {\n      color = \"RED\";\n      System.out.println(\"Light changed from YELLOW to\nRED. Stop!\");\n    }\n  }\n  public String getColor() {\n    return color;\n  }\n}",
      "fontSize": 7.685702313322019,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "public class TrafficLight {\n  private String color;\n  public TrafficLight() {\n    this.color = \"RED\"; // start with red\n  }\n  public void next() {\n    if (color.equals(\"RED\")) {\n      color = \"GREEN\";\n      System.out.println(\"Light changed from RED to GREEN. Cars go!\");\n    } else if (color.equals(\"GREEN\")) {\n      color = \"YELLOW\";\n      System.out.println(\"Light changed from GREEN to YELLOW. Slow down!\");\n    } else if (color.equals(\"YELLOW\")) {\n      color = \"RED\";\n      System.out.println(\"Light changed from YELLOW to RED. Stop!\");\n    }\n  }\n  public String getColor() {\n    return color;\n  }\n}",
      "autoResize": false,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
