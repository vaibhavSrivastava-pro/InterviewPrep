    {
      "id": "egDLSRGpQUTqPSyEMeUkW",
      "type": "text",
      "x": -511.0314884341965,
      "y": 349.1633104521552,
      "width": 274.76347655910337,
      "height": 163.32117415809293,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bfF",
      "roundness": null,
      "seed": 111044504,
      "version": 423,
      "versionNonce": 697977120,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793272909494,
      "link": null,
      "locked": false,
      "text": "YouTubeChannelImpl channel = new YouTubeChannelImpl();\n    // Create subscribers\n    YouTubeSubscriber alice = new YouTubeSubscriber(\"Alice\");\n    YouTubeSubscriber bob = new YouTubeSubscriber(\"Bob\");\n    // Subscribe to the channel\n    channel.addSubscriber(alice);\n    channel.addSubscriber(bob);\n    // Upload a new video and notify subscribers\n    channel.uploadNewVideo(\"Java Design Patterns Tutorial\");\n    // Output:\n    // Alice is watching the video: Java Design Patterns Tutorial\n    // Bob is watching the video: Java Design Patterns Tutorial\n    // You can also remove a subscriber and upload another video\n    channel.removeSubscriber(bob);\n    channel.uploadNewVideo(\"Observer Pattern in Action\");\n    // Output:\n    // Alice is watching the video: Observer Pattern in Action",
      "fontSize": 7.685702313322018,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "YouTubeChannelImpl channel = new YouTubeChannelImpl();\n    // Create subscribers\n    YouTubeSubscriber alice = new YouTubeSubscriber(\"Alice\");\n    YouTubeSubscriber bob = new YouTubeSubscriber(\"Bob\");\n    // Subscribe to the channel\n    channel.addSubscriber(alice);\n    channel.addSubscriber(bob);\n    // Upload a new video and notify subscribers\n    channel.uploadNewVideo(\"Java Design Patterns Tutorial\");\n    // Output:\n    // Alice is watching the video: Java Design Patterns Tutorial\n    // Bob is watching the video: Java Design Patterns Tutorial\n    // You can also remove a subscriber and upload another video\n    channel.removeSubscriber(bob);\n    channel.uploadNewVideo(\"Observer Pattern in Action\");\n    // Output:\n    // Alice is watching the video: Observer Pattern in Action",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
