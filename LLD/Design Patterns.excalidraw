      "isDeleted": false,
      "boundElements": [],
      "updated": 1793272909494,
      "link": null,
      "locked": false,
      "text": "Actions we want to perform should be wrapped in as\ncommands.\n\nUsing this approach, new commands can be added\nwithout touching the existing commands, making it\nmore “Open/Close”",
      "fontSize": 7.685702313322019,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Actions we want to perform should be wrapped in as commands.\n\nUsing this approach, new commands can be added without touching the existing commands, making it more “Open/Close”",
      "autoResize": false,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
