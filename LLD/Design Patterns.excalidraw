      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "_pNMrEgjpIRqKT-11klz2",
      "type": "text",
      "x": -165.60460106918026,
      "y": 18.03115240492707,
      "width": 162.68681836487124,
      "height": 38.4285115666101,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bej",
      "roundness": null,
      "seed": 2045263592,
      "version": 734,
      "versionNonce": 811632928,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793272909494,
      "link": null,
      "locked": false,
      "text": "Observer Pattern allows one object (the\nsubject) to notify other objects (the\nobservers) whenever there is a change in\nits state",
      "fontSize": 7.685702313322021,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Observer Pattern allows one object (the subject) to notify other objects (the observers) whenever there is a change in its state",
      "autoResize": false,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "jhqaPu5XHurs0OodiD3VA",
      "type": "text",
      "x": -165.45118929728733,
      "y": 65.26067095744975,
      "width": 162.0672999283989,
      "height": 28.82138367495758,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bek",
      "roundness": null,
      "seed": 2130982888,
      "version": 680,
      "versionNonce": 1788877024,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793272909494,
      "link": null,
      "locked": false,
      "text": "The type of subscriber becomes flexible\nmaking it more open for extension and\nclosed for modification.",
      "fontSize": 7.685702313322021,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The type of subscriber becomes flexible making it more open for extension and closed for modification.",
      "autoResize": false,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "JxcSMGTs4OGyrlWIpWnkK",
      "type": "text",
      "x": -1205.9250007312276,
      "y": 236.85806511798773,
      "width": 287.4448677849082,
      "height": 192.1425578330505,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bel",
      "roundness": null,
      "seed": 479688168,
      "version": 274,
      "versionNonce": 565339424,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793272909494,
      "link": null,
      "locked": false,
      "text": "Old Payment Processor without strategy\n\npublic void processPayment(String paymentMethod) {\n    if (paymentMethod.equals(\"CreditCard\")) {\n      // Process Credit Card payment\n      System.out.println(\"Processing credit card payment...\");\n    } else if (paymentMethod.equals(\"PayPal\")) {\n      // Process PayPal payment\n      System.out.println(\"Processing PayPal payment...\");\n    } else if (paymentMethod.equals(\"Crypto\")) {\n      // Process Crypto payment\n      System.out.println(\"Processing crypto payment...\");\n    } else if (paymentMethod.equals(\"Stripe\")) { // New method added\n      // Process Stripe payment\n      System.out.println(\"Processing Stripe payment...\");\n    } else {\n      // If an unsupported payment method is entered\n      System.out.println(\"Payment method not supported.\");\n    }\n  }",
      "fontSize": 7.685702313322019,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Old Payment Processor without strategy\n\npublic void processPayment(String paymentMethod) {\n    if (paymentMethod.equals(\"CreditCard\")) {\n      // Process Credit Card payment\n      System.out.println(\"Processing credit card payment...\");\n    } else if (paymentMethod.equals(\"PayPal\")) {\n      // Process PayPal payment\n      System.out.println(\"Processing PayPal payment...\");\n    } else if (paymentMethod.equals(\"Crypto\")) {\n      // Process Crypto payment\n      System.out.println(\"Processing crypto payment...\");\n    } else if (paymentMethod.equals(\"Stripe\")) { // New method added\n      // Process Stripe payment\n      System.out.println(\"Processing Stripe payment...\");\n    } else {\n      // If an unsupported payment method is entered\n      System.out.println(\"Payment method not supported.\");\n    }\n  }",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "6L1UKPPYVy0ta4kMbwn99",
      "type": "text",
      "x": -122.58720917891333,
      "y": 122.98413602529263,
      "width": 40.196190261811246,
      "height": 36.02672959369697,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
