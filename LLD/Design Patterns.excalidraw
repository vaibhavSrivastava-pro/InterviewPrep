      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "public class BeverageTemplateDemo {\n  public static void main(String[] args) {\n    Beverage coffee = new CoffeeBeverage();\n    Beverage tea = new TeaBeverage();\n    System.out.println(\"Making coffee...\");\n    coffee.prepareRecipe();\n    System.out.println(\"\\\nMaking tea...\");\n    tea.prepareRecipe();\n  }\n}",
