    {
      "id": "cIluNf2Nxsdsmjcu5ocCG",
      "type": "text",
      "x": -1952.5717979594178,
      "y": 1615.5488545027993,
      "width": 329.71617187092414,
      "height": 115.28553469983032,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
