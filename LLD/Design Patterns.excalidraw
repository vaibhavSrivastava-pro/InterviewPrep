    },
    {
      "id": "xfrComJUBVYTD7BVbk4t8",
      "type": "text",
      "x": -1647.7946069571456,
      "y": 0.5654350504962622,
      "width": 152.7116685368644,
      "height": 28.82138367495758,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "beK",
      "roundness": null,
      "seed": 1969290472,
      "version": 316,
      "versionNonce": 1468925152,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793272909494,
      "link": null,
      "locked": false,
      "text": "Strategy Pattern allows you to define a\nfamily of algorithms or behaviors, and\nchoose the one to use during runtime",
      "fontSize": 7.685702313322018,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Strategy Pattern allows you to define a family of algorithms or behaviors, and choose the one to use during runtime",
      "autoResize": false,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "cCPWLiNTdNNkAHUssVcQ8",
      "type": "rectangle",
      "x": -1786.403419180996,
      "y": 312.46612309992406,
      "width": 92.45634708114737,
      "height": 38.120435477553094,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
