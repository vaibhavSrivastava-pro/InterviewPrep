    },
    {
      "id": "K25r8oxcUqdnvk_GOyR1X",
      "type": "text",
      "x": -678.0957534715781,
      "y": -245.72316983983978,
      "width": 254.6542010363104,
      "height": 67.24989524156767,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "beI",
      "roundness": null,
      "seed": 1319893480,
      "version": 320,
      "versionNonce": 858071264,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793272909494,
      "link": null,
      "locked": false,
      "text": "Behavioral design patterns are all about how objects interact and\ncommunicate with each other. \nThese patterns focus on the behavior of objects, how they\ncollaborate to complete a task, and how the flow of control is\nmanaged between them. \nIn simple terms, they help in defining the roles and responsibilities\nof objects in a way that makes communication clear and organized.",
      "fontSize": 7.685702313322019,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Behavioral design patterns are all about how objects interact and communicate with each other. \nThese patterns focus on the behavior of objects, how they collaborate to complete a task, and how the flow of control is managed between them. \nIn simple terms, they help in defining the roles and responsibilities of objects in a way that makes communication clear and organized.",
      "autoResize": false,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "9MLIV1M8byL-X1aoyv08l",
      "type": "text",
      "x": -1603.3681850018188,
      "y": -30.446897182155908,
      "width": 57.80799247574953,
      "height": 16.812473810391918,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "beJ",
      "roundness": null,
      "seed": 744807144,
      "version": 411,
