      "versionNonce": 1970462944,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793272909494,
      "link": null,
      "locked": false,
      "text": "public static class CarBuilder {\n    private String engine;\n    private int wheels = 4; // Default value\n    private int seats = 5; // Default value\n\n    // Builder methods to set attributes\n    public CarBuilder setEngine(String engine) {\n      this.engine = engine;\n      return this;\n    }\n    public CarBuilder setWheels(int wheels) {\n      this.wheels = wheels;\n      return this;\n    }\n    public CarBuilder setSeats(int seats) {\n      this.seats = seats;\n      return this;\n    }\n\n    // Build method to create a Car object\n    public Car build() {\n      return new Car(\n          this); \n    }\n  }",
      "fontSize": 7.27905634183949,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "public static class CarBuilder {\n    private String engine;\n    private int wheels = 4; // Default value\n    private int seats = 5; // Default value\n\n    // Builder methods to set attributes\n    public CarBuilder setEngine(String engine) {\n      this.engine = engine;\n      return this;\n    }\n    public CarBuilder setWheels(int wheels) {\n      this.wheels = wheels;\n      return this;\n    }\n    public CarBuilder setSeats(int seats) {\n      this.seats = seats;\n      return this;\n    }\n\n    // Build method to create a Car object\n    public Car build() {\n      return new Car(\n          this); \n    }\n  }",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
