      "updated": 1793272909494,
      "link": null,
      "locked": false,
      "text": "public void playPlaylist(boolean shuffle) {\n    if (shuffle) {\n      // Shuffle the songs and then play\n      System.out.println(\"Shuffling playlist...\");\n      // Shuffle logic here...\n    } else {\n      for (int i = 0; i < songs.size(); i++) {\n        System.out.println(\"Playing song: \" + songs.get(i));\n      }\n    }\n  }",
      "fontSize": 7.685702313322019,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "public void playPlaylist(boolean shuffle) {\n    if (shuffle) {\n      // Shuffle the songs and then play\n      System.out.println(\"Shuffling playlist...\");\n      // Shuffle logic here...\n    } else {\n      for (int i = 0; i < songs.size(); i++) {\n        System.out.println(\"Playing song: \" + songs.get(i));\n      }\n    }\n  }",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
