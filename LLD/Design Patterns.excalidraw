    {
      "id": "xfI9JUldLjT39AOo6_n6R",
      "type": "text",
      "x": 1131.0046502814976,
      "y": -778.6971732316474,
      "width": 162.94962397871856,
      "height": 86.46415102487272,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "beG",
      "roundness": null,
      "seed": 879132136,
      "version": 252,
      "versionNonce": 443530464,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793272909494,
      "link": null,
      "locked": false,
      "text": "• The volatile keyword ensures that when\none thread updates the instance, it’s\nvisible to all other threads. This prevents\nany threads from getting an outdated\nversion of the Logger object.\n\n• We only use the synchronized block\nonce—when the instance is null and needs\nto be created.",
      "fontSize": 7.68570231332202,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• The volatile keyword ensures that when one thread updates the instance, it’s visible to all other threads. This prevents any threads from getting an outdated version of the Logger object.\n\n• We only use the synchronized block once—when the instance is null and needs to be created.",
      "autoResize": false,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "-qiJnU6WuNIL7eEBv-mUK",
