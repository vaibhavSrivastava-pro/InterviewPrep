      "versionNonce": 2082456864,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793272909494,
      "link": null,
      "locked": false,
      "text": "The setting part\nhappens in the\nbuilder class.\n\nIt simplifies the\nobject creation and\nwe do not need\nmultiple\nconstructors.",
      "fontSize": 7.685702313322019,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The setting part happens in the builder class.\n\nIt simplifies the object creation and we do not need multiple constructors.",
      "autoResize": false,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
