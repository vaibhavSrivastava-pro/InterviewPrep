      "x": 2730.64319141539,
      "y": 274.336447273316,
      "width": 254.7565622844459,
      "height": 144.10691837478788,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bgX",
      "roundness": null,
      "seed": 1197573352,
      "version": 383,
      "versionNonce": 1180346656,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "pGL5v1S7OxTG9aLtKzXNZ",
          "type": "arrow"
        }
      ],
      "updated": 1793272909494,
      "link": null,
      "locked": false,
      "text": "    TV tv = new TV();\n    // Create commands\n    Command turnOn = new TurnOnCommand(tv);\n    Command turnOff = new TurnOffCommand(tv);\n    Command changeChannel = new ChangeChannelCommand(tv, 5);\n    Command adjustVolume = new AdjustVolumeCommand(tv, 20);\n    // Create remote control\n    RemoteControl remote = new RemoteControl();\n    remote.setOnCommand(turnOn);\n    remote.setOffCommand(turnOff);\n    remote.pressOnButton(); // Turn on the TV\n    remote.pressOffButton(); // Turn off the TV\n    // Execute other commands\n    changeChannel.execute(); // Change the channel\n    adjustVolume.execute(); // Adjust the volume",
      "fontSize": 7.685702313322019,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "    TV tv = new TV();\n    // Create commands\n    Command turnOn = new TurnOnCommand(tv);\n    Command turnOff = new TurnOffCommand(tv);\n    Command changeChannel = new ChangeChannelCommand(tv, 5);\n    Command adjustVolume = new AdjustVolumeCommand(tv, 20);\n    // Create remote control\n    RemoteControl remote = new RemoteControl();\n    remote.setOnCommand(turnOn);\n    remote.setOffCommand(turnOff);\n    remote.pressOnButton(); // Turn on the TV\n    remote.pressOffButton(); // Turn off the TV\n    // Execute other commands\n    changeChannel.execute(); // Change the channel\n    adjustVolume.execute(); // Adjust the volume",
      "autoResize": false,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
