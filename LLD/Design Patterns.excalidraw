      "index": "bhf",
      "roundness": null,
      "seed": 378061783,
      "version": 671,
      "versionNonce": 465911072,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793272909494,
      "link": null,
      "locked": false,
      "text": "public class AirConditionerAdapter implements SmartDevice {\n  private AirConditioner airConditioner;\n  // Constructor\n  public AirConditionerAdapter(AirConditioner airConditioner) {\n    this.airConditioner = airConditioner;\n  }\n\n  @Override\n  public void turnOn() {\n    airConditioner.connectViaBluetooth();\n    airConditioner.startCooling();\n  }\n\n  @Override\n  public void turnOff() {\n    airConditioner.stopCooling();\n    airConditioner.disconnectBluetooth();\n  }\n}",
      "fontSize": 6.631365323285555,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "public class AirConditionerAdapter implements SmartDevice {\n  private AirConditioner airConditioner;\n  // Constructor\n  public AirConditionerAdapter(AirConditioner airConditioner) {\n    this.airConditioner = airConditioner;\n  }\n\n  @Override\n  public void turnOn() {\n    airConditioner.connectViaBluetooth();\n    airConditioner.startCooling();\n  }\n\n  @Override\n  public void turnOff() {\n    airConditioner.stopCooling();\n    airConditioner.disconnectBluetooth();\n  }\n}",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
