      "seed": 1221280087,
      "version": 644,
      "versionNonce": 1580500192,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793272909494,
      "link": null,
      "locked": false,
      "text": "public abstract class CoffeeDecorator implements Coffee {\n    protected Coffee coffee;\n    public CoffeeDecorator(Coffee coffee) {\n        this.coffee = coffee;\n    }\n    @Override\n    public String getDescription() {\n        return coffee.getDescription();\n    }\n    @Override\n    public double getCost() {\n        return coffee.getCost();\n    }\n}",
      "fontSize": 4.803298175916418,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "public abstract class CoffeeDecorator implements Coffee {\n    protected Coffee coffee;\n    public CoffeeDecorator(Coffee coffee) {\n        this.coffee = coffee;\n    }\n    @Override\n    public String getDescription() {\n        return coffee.getDescription();\n    }\n    @Override\n    public double getCost() {\n        return coffee.getCost();\n    }\n}",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
