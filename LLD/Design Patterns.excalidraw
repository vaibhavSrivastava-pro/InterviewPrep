    {
      "id": "tLDydMnz8ycMRVNmekI_g",
      "type": "text",
      "x": 3927.895932061386,
      "y": 20.914561977127505,
      "width": 194.3476139594704,
      "height": 38.4285115666101,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
