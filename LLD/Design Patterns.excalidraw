      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "23J6sVWudBnrjyQzoh2xy",
      "type": "text",
      "x": 17335.95334166327,
      "y": -163.8252627480606,
      "width": 972.9270361615763,
      "height": 210,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bka",
      "roundness": null,
      "seed": 2027241751,
      "version": 285,
      "versionNonce": 922045664,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793272909494,
      "link": null,
      "locked": false,
      "text": "Remote Proxy Object → Suppose a server has a model and client\nneeds to call that model, but it doesn’t exist on client side. In order\nto communicate with the server, we need to have a model that can\ntalk between the client and server. Such a model is a proxy model. It\njust mimics the model present on the server such that the client\nunderstands it too.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Remote Proxy Object → Suppose a server has a model and client needs to call that model, but it doesn’t exist on client side. In order to communicate with the server, we need to have a model that can talk between the client and server. Such a model is a proxy model. It just mimics the model present on the server such that the client understands it too.",
      "autoResize": false,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
