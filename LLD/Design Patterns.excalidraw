      "seed": 1413036313,
      "version": 221,
      "versionNonce": 1084067104,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793272909494,
      "link": null,
      "locked": false,
      "text": "class Supervisor extends Approver {\n  @Override\n  public void processLeaveRequest(int leaveDays) {\n    if (leaveDays <= 3) {\n      System.out.println(\"Supervisor approved the leave.\");\n    } else if (nextApprover != null) {\n      nextApprover.processLeaveRequest(leaveDays);\n    }\n  }\n}",
      "fontSize": 10.96080328564665,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class Supervisor extends Approver {\n  @Override\n  public void processLeaveRequest(int leaveDays) {\n    if (leaveDays <= 3) {\n      System.out.println(\"Supervisor approved the leave.\");\n    } else if (nextApprover != null) {\n      nextApprover.processLeaveRequest(leaveDays);\n    }\n  }\n}",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
