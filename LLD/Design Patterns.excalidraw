    {
      "id": "XtTGASlmtcJZDClMtDS3e",
      "type": "text",
      "x": 32.44488020581002,
      "y": 440.54638309120674,
      "width": 249.40069410749388,
      "height": 259.3924530746182,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
