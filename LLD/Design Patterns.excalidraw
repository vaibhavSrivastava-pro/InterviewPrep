      "updated": 1793272909494,
      "link": null,
      "locked": false,
      "text": "public class PaymentProcessor {\n  private PaymentStrategy paymentStrategy; \n  public PaymentProcessor(PaymentStrategy paymentStrategy) {\n    this.paymentStrategy = paymentStrategy;\n  }\n\n  // Process payment using the current strategy\n  public void processPayment() {\n    paymentStrategy\n        .processPayment();\n  }\n\n \n  public void setPaymentStrategy(PaymentStrategy\npaymentStrategy) {\n    this.paymentStrategy = paymentStrategy;\n  }\n}",
      "fontSize": 7.685702313322018,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "public class PaymentProcessor {\n  private PaymentStrategy paymentStrategy; \n  public PaymentProcessor(PaymentStrategy paymentStrategy) {\n    this.paymentStrategy = paymentStrategy;\n  }\n\n  // Process payment using the current strategy\n  public void processPayment() {\n    paymentStrategy\n        .processPayment();\n  }\n\n \n  public void setPaymentStrategy(PaymentStrategy paymentStrategy) {\n    this.paymentStrategy = paymentStrategy;\n  }\n}",
      "autoResize": false,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
