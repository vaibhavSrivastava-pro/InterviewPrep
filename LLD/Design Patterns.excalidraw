      "link": null,
      "locked": false,
      "text": "class RedState implements TrafficLightState {\n  @Override\n  public void next(TrafficLightContext context) {\n    System.out.println(\"Switching from RED to GREEN. Cars go!\");\n    context.setState(new GreenState());\n  }\n  @Override\n  public String getColor() {\n    return \"RED\";\n  }\n}",
      "fontSize": 7.685702313322018,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class RedState implements TrafficLightState {\n  @Override\n  public void next(TrafficLightContext context) {\n    System.out.println(\"Switching from RED to GREEN. Cars go!\");\n    context.setState(new GreenState());\n  }\n  @Override\n  public String getColor() {\n    return \"RED\";\n  }\n}",
